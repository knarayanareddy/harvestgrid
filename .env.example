# Safe local examples only. Owners: future API, Ring adapter, workers, and workflow.
APP_ENV=local
AWS_REGION=us-east-1
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DEMO_MODE=fixture
DATA_RETENTION_DAYS=7
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
BEDROCK_MODEL_ID=
PROMPT_SET_VERSION=
FEATURE_VERSION=features_v1
# Ring remains disabled until official API/SDK capability mapping is verified.
RING_ADAPTER=disabled
RING_OAUTH_CLIENT_ID=
RING_OAUTH_SECRET_REFERENCE=
WEATHER_ADAPTER=disabled
