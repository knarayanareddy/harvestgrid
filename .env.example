# Safe local examples only. Owners: future API, Ring adapter, workers, and workflow.
APP_ENV=local
AWS_REGION=us-east-1
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DEMO_MODE=fixture
DATA_RETENTION_DAYS=7
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
BEDROCK_MODEL_ID=
PROMPT_SET_VERSION=
FEATURE_VERSION=features_v1
# Ring remains disabled until official API/SDK capability mapping is verified.
RING_ADAPTER=disabled
RING_OAUTH_CLIENT_ID=
RING_OAUTH_SECRET_REFERENCE=
WEATHER_ADAPTER=disabled
WEATHER_POLL_INTERVAL_MINUTES=360
WEATHER_FORECAST_DAYS=10
FORECASTING_BROKER_URL=
# Notifications default to the fixture transport. SNS requires opt-in; Twilio requires a
# messaging service and is used only for volunteers who opted in to SMS.
NOTIFICATION_TRANSPORT=fixture
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN_SECRET_REFERENCE=
TWILIO_FROM_NUMBER=
SNS_SMS_REGION=eu-west-1
SNS_SMS_MAX_PRICE_USD=0.05
NOTIFICATION_QUIET_HOURS=21-7
# Vision weights are never committed; point this at a verified local artifact.
VISION_ONNX_WEIGHTS_PATH=
VISION_ONNX_SHA256=
