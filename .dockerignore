# Keep the build context to sources.
#
# docs/media is *not* excluded: apps/web/Dockerfile copies the recorded walkthrough into the
# bundle so the Demo Video tab works in the container. Everything else that is generated
# (dist, caches, coverage, model artifacts) stays out.
.git
.github
node_modules
**/node_modules
**/.pnpm-store
apps/web/dist
**/__pycache__
**/*.pyc
.venv
**/.venv
.pytest_cache
.mypy_cache
.ruff_cache
coverage
coverage.xml
data
docs/media/.playwright-raw
*.onnx
*.pt
*.pth
