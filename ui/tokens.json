{
  "meta": {
    "project": "HarvestGrid",
    "version": "1.0.0",
    "platforms": ["responsive_web", "outdoor_mobile"],
    "theme": "light_field_operations_ledger",
    "contrast_pairs": {
      "text_on_canvas": { "foreground": "color.text", "background": "color.canvas", "minimum": 4.5 },
      "muted_on_canvas": { "foreground": "color.text_muted", "background": "color.canvas", "minimum": 4.5 },
      "text_on_surface": { "foreground": "color.text", "background": "color.surface", "minimum": 4.5 },
      "muted_on_surface": { "foreground": "color.text_muted", "background": "color.surface", "minimum": 4.5 },
      "primary_button": { "foreground": "color.on_primary", "background": "color.primary", "minimum": 4.5 },
      "accent_button": { "foreground": "color.on_accent", "background": "color.accent", "minimum": 4.5 },
      "focus_on_canvas": { "foreground": "color.focus", "background": "color.canvas", "minimum": 3.0 },
      "success_on_surface": { "foreground": "color.success", "background": "color.surface", "minimum": 4.5 },
      "warning_on_surface": { "foreground": "color.warning", "background": "color.surface", "minimum": 4.5 },
      "danger_on_surface": { "foreground": "color.danger", "background": "color.surface", "minimum": 4.5 }
    }
  },
  "color": {
    "canvas": { "$type": "color", "$value": "#F4F2EC" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "surface_alt": { "$type": "color", "$value": "#E7ECE5" },
    "text": { "$type": "color", "$value": "#21332B" },
    "text_muted": { "$type": "color", "$value": "#506057" },
    "primary": { "$type": "color", "$value": "#2E5D46" },
    "on_primary": { "$type": "color", "$value": "#FFFFFF" },
    "accent": { "$type": "color", "$value": "#743A58" },
    "on_accent": { "$type": "color", "$value": "#FFFFFF" },
    "border": { "$type": "color", "$value": "#B8C4B9" },
    "focus": { "$type": "color", "$value": "#1D5F8A" },
    "success": { "$type": "color", "$value": "#2F6547" },
    "warning": { "$type": "color", "$value": "#704B00" },
    "danger": { "$type": "color", "$value": "#8E3539" },
    "info": { "$type": "color", "$value": "#2D5D82" }
  },
  "typography": {
    "display": { "$type": "fontFamily", "$value": "IBM Plex Sans, Segoe UI, sans-serif" },
    "body": { "$type": "fontFamily", "$value": "IBM Plex Sans, Segoe UI, sans-serif" },
    "data": { "$type": "fontFamily", "$value": "IBM Plex Mono, SFMono-Regular, monospace" },
    "size_display": { "$type": "dimension", "$value": "2rem" },
    "size_title": { "$type": "dimension", "$value": "1.375rem" },
    "size_body": { "$type": "dimension", "$value": "0.9375rem" },
    "size_small": { "$type": "dimension", "$value": "0.8125rem" },
    "line_body": { "$type": "number", "$value": 1.45 }
  },
  "spacing": {
    "unit": { "$type": "dimension", "$value": "0.25rem" },
    "page": { "$type": "dimension", "$value": "1.5rem" },
    "section": { "$type": "dimension", "$value": "2rem" },
    "control": { "$type": "dimension", "$value": "0.625rem" },
    "table_cell": { "$type": "dimension", "$value": "0.75rem" }
  },
  "shape": {
    "radius_small": { "$type": "dimension", "$value": "4px" },
    "radius_large": { "$type": "dimension", "$value": "8px" },
    "target_minimum": { "$type": "dimension", "$value": "44px" },
    "focus_width": { "$type": "dimension", "$value": "3px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "100ms" },
    "standard": { "$type": "duration", "$value": "160ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0.0, 0.0, 1.0] }
  },
  "layout": {
    "content_max": { "$type": "dimension", "$value": "1440px" },
    "reading_max": { "$type": "dimension", "$value": "68ch" },
    "dense_table_min": { "$type": "dimension", "$value": "760px" }
  }
}
